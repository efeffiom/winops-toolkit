<Page x:Class="WinOps.App.Views.ActiveDirectoryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=System.Runtime"
      Background="{DynamicResource AppBackground}">
    <Page.Resources>
        <sys:Boolean x:Key="TrueValue">True</sys:Boolean>
        <sys:Boolean x:Key="FalseValue">False</sys:Boolean>
    </Page.Resources>
    <Grid Margin="26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Query directory" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsAvailable}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Run domain diagnostics" Command="{Binding RunDiagnosticsCommand}" IsEnabled="{Binding IsAvailable}" Style="{StaticResource BaseButton}"/>
                <Button Content="Enable" Command="{Binding SetUserStateCommand}" CommandParameter="{StaticResource TrueValue}" Style="{StaticResource BaseButton}"/>
                <Button Content="Disable" Command="{Binding SetUserStateCommand}" CommandParameter="{StaticResource FalseValue}" Style="{StaticResource DangerButton}"/>
                <Button Content="Unlock" Command="{Binding UnlockUserCommand}" Style="{StaticResource SecondaryButton}"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
            </StackPanel>
            <TextBlock Text="{Binding PrerequisiteMessage}" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <TabControl>
                <TabItem Header="Users">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Height="420" Margin="0,0,10,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Account" Binding="{Binding SamAccountName}" Width="160"/>
                                <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="200"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>
                                <DataGridTextColumn Header="Enabled" Binding="{Binding Enabled}" Width="85"/>
                                <DataGridTextColumn Header="Locked" Binding="{Binding LockedOut}" Width="85"/>
                                <DataGridTextColumn Header="Last logon" Binding="{Binding LastLogon}" Width="180"/>
                                <DataGridTextColumn Header="Groups" Binding="{Binding Groups, Converter={StaticResource ListToStringConverter}}" Width="260"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Domain" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Domain.Name, StringFormat='Name: {0}'}"/>
                            <TextBlock Text="{Binding Domain.Forest, StringFormat='Forest: {0}'}"/>
                            <TextBlock Text="{Binding Domain.DomainController, StringFormat='DC: {0}'}"/>
                            <TextBlock Text="Reset password" Style="{StaticResource SectionTitle}" Margin="0,14,0,0"/>
                            <PasswordBox x:Name="AdPasswordBox"/>
                            <Button Content="Reset password" Click="ResetAdPassword_Click" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Groups">
                    <DataGrid ItemsSource="{Binding Groups}" Height="430">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="240"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="130"/>
                            <DataGridTextColumn Header="Distinguished name" Binding="{Binding DistinguishedName}" Width="560"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Organizational units">
                    <DataGrid ItemsSource="{Binding Units}" Height="430">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260"/>
                            <DataGridTextColumn Header="Distinguished name" Binding="{Binding DistinguishedName}" Width="620"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Diagnostics">
                    <DataGrid ItemsSource="{Binding Findings}" Height="430">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Check" Binding="{Binding Title}" Width="240"/>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="420"/>
                            <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="360"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
