<Page x:Class="WinOps.App.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Background="{DynamicResource AppBackground}">
    <Grid Margin="26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="Refresh all" Command="{Binding RefreshAllCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Create restore point" Command="{Binding CreateRestorePointCommand}" Style="{StaticResource BaseButton}"/>
            <Button Content="Restart" Command="{Binding PowerCommand}" CommandParameter="restart" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Shut down" Command="{Binding PowerCommand}" CommandParameter="shutdown" Style="{StaticResource DangerButton}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Computer" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Info.ComputerName}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Info.OsCaption}" Style="{StaticResource SubtleText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Metrics.CpuUsagePercent, StringFormat='{}{0:0.0}%'}" Style="{StaticResource MetricValue}"/>
                            <TextBlock Text="{Binding Info.ProcessorName}" Style="{StaticResource SubtleText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Memory" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Metrics.MemoryUsagePercent, StringFormat='{}{0:0.0}%'}" Style="{StaticResource MetricValue}"/>
                            <TextBlock Text="{Binding Info.TotalMemoryBytes, StringFormat='{}{0:N0} bytes'}" Style="{StaticResource SubtleText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Uptime" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Info.Uptime}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Info.LastBootTime, StringFormat='Last boot: {0:g}'}" Style="{StaticResource SubtleText}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Live utilization" Style="{StaticResource SectionTitle}"/>
                        <lvc:CartesianChart Height="260" Series="{Binding UsageSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" LegendPosition="Bottom"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="System details" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel>
                            <TextBlock Text="{Binding Info.Domain, StringFormat='Domain: {0}  '}" Margin="0,0,18,6"/>
                            <TextBlock Text="{Binding Info.OsVersion, StringFormat='Version: {0}  '}" Margin="0,0,18,6"/>
                            <TextBlock Text="{Binding Info.BuildNumber, StringFormat='Build: {0}  '}" Margin="0,0,18,6"/>
                            <TextBlock Text="{Binding Info.Architecture, StringFormat='Architecture: {0}  '}" Margin="0,0,18,6"/>
                            <TextBlock Text="{Binding Info.Manufacturer, StringFormat='Manufacturer: {0}  '}" Margin="0,0,18,6"/>
                            <TextBlock Text="{Binding Info.Model, StringFormat='Model: {0}  '}" Margin="0,0,18,6"/>
                            <TextBlock Text="{Binding Info.ActivationStatus, StringFormat='Activation: {0}  '}" Margin="0,0,18,6"/>
                            <TextBlock Text="{Binding Info.DefenderStatus, StringFormat='Defender: {0}  '}" Margin="0,0,18,6"/>
                            <TextBlock Text="{Binding Info.FirewallStatus, StringFormat='Firewall: {0}  '}" Margin="0,0,18,6"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Restore point label:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding RestorePointDescription}" Width="320"/>
                            <TextBlock Text="Refresh seconds:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                            <TextBox Text="{Binding RefreshSeconds}" Width="70"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}"/>
                <ProgressBar Value="{Binding ProgressPercent}" Width="200" Margin="14,0"
                             Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
