<Window x:Class="WinOps.App.Views.RestorePointDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create restore point" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="System checkpoint" FontSize="19" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="Enter a description that identifies the change you are about to make."
                   TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"/>
        <TextBox x:Name="DescriptionBox" Text="WinOps Toolkit checkpoint" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Width="100"/>
            <Button Content="Create" IsDefault="True" Click="Create_Click" Style="{StaticResource BaseButton}" Width="110" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
