<Page x:Class="WinOps.App.Views.UsersView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=System.Runtime"
      Background="{DynamicResource AppBackground}">
    <Page.Resources>
        <sys:Boolean x:Key="TrueValue">True</sys:Boolean>
        <sys:Boolean x:Key="FalseValue">False</sys:Boolean>
    </Page.Resources>
    <Grid Margin="26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Enable" Command="{Binding SetAccountStateCommand}" CommandParameter="{StaticResource TrueValue}" Style="{StaticResource BaseButton}"/>
            <Button Content="Disable" Command="{Binding SetAccountStateCommand}" CommandParameter="{StaticResource FalseValue}" Style="{StaticResource DangerButton}"/>
            <Button Content="Export CSV" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <TabControl>
                <TabItem Header="Accounts">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Height="430" Margin="0,0,10,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                                <DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="200"/>
                                <DataGridTextColumn Header="Enabled" Binding="{Binding Enabled}" Width="85"/>
                                <DataGridTextColumn Header="Locked" Binding="{Binding AccountLocked}" Width="85"/>
                                <DataGridTextColumn Header="Password required" Binding="{Binding PasswordRequired}" Width="140"/>
                                <DataGridTextColumn Header="Last logon" Binding="{Binding LastLogon}" Width="180"/>
                                <DataGridTextColumn Header="Groups" Binding="{Binding Groups, Converter={StaticResource ListToStringConverter}}" Width="280"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Reset selected password" Style="{StaticResource SectionTitle}"/>
                            <PasswordBox x:Name="ResetPasswordBox" PasswordChar="*" Height="32" Margin="0,0,0,8"/>
                            <Button Content="Reset password" Click="ResetPassword_Click" Style="{StaticResource DangerButton}"/>
                            <TextBlock Text="Group membership" Style="{StaticResource SectionTitle}" Margin="0,14,0,0"/>
                            <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" Width="270"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add to group" Command="{Binding ChangeGroupMembershipCommand}" CommandParameter="{StaticResource TrueValue}" Style="{StaticResource BaseButton}"/>
                                <Button Content="Remove" Command="{Binding ChangeGroupMembershipCommand}" CommandParameter="{StaticResource FalseValue}" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Create user">
                    <StackPanel Width="520" HorizontalAlignment="Left" Margin="20">
                        <TextBlock Text="User name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding NewUserName}"/>
                        <TextBlock Text="Full name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding NewUserFullName}"/>
                        <TextBlock Text="Initial password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="NewPasswordBox"/>
                        <Button Content="Create local user" Click="CreateUser_Click" Style="{StaticResource BaseButton}" Margin="0,16,0,0"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Bulk operations">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Apply CSV" Command="{Binding ApplyBulkCommand}" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                        <TextBox Grid.Row="1" Text="{Binding BulkCsv}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Height="230"/>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding BulkResults}" Height="140" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Success" Binding="{Binding Success}" Width="80"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="520"/>
                                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="360"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
