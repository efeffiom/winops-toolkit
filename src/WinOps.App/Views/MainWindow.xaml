<Window x:Class="WinOps.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinOps Toolkit" Height="820" Width="1380"
        MinHeight="620" MinWidth="1020"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource NavBackgroundBrush}" Padding="18,20,14,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,0,0,18">
                    <TextBlock Text="WINOPS" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="TOOLKIT" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{DynamicResource NavSubtleTextBrush}" Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,0,0,14" Background="{DynamicResource NavSurfaceBrush}" CornerRadius="8" Padding="8">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource NavInputBackgroundBrush}" Foreground="White"
                             BorderBrush="{DynamicResource NavInputBorderBrush}" Margin="0"
                             ToolTip="Search modules" />
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.NavigateCommand, ElementName=Root}"
                                        CommandParameter="{Binding Key}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Foreground="{DynamicResource NavTextBrush}" Padding="12,9" Margin="0,1"
                                        HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="SelectionBar" Width="3" HorizontalAlignment="Left"
                                                            VerticalAlignment="Stretch" Margin="-12,0,0,0"
                                                            Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                                            Visibility="Collapsed"/>
                                                    <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{TemplateBinding Foreground}"/>
                                                        <TextBlock x:Name="CategoryText" Text="{Binding Category}" FontSize="10"
                                                                   Foreground="{DynamicResource NavSubtleTextBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource NavSurfaceBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                                    <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource NavSelectedTextBrush}"/>
                                                    <Setter TargetName="CategoryText" Property="Foreground" Value="{DynamicResource NavSelectedTextBrush}"/>
                                                    <Setter TargetName="CategoryText" Property="Opacity" Value="0.85"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Margin="4,12,0,0">
                    <TextBlock Text="{Binding UserName}" Foreground="{DynamicResource NavTextBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding PrivilegeLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="26,18,26,16"
                    BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentTitle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Native Windows administration and diagnostics" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="10,5" Margin="0,0,10,0"
                                Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="ADMINISTRATOR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                        <Button Content="{Binding ThemeLabel}" Command="{Binding ToggleThemeCommand}" Style="{StaticResource SecondaryButton}" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame Grid.Row="1" x:Name="ContentFrame" Content="{Binding CurrentPage}"
                   NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal" Margin="0"
                   Background="Transparent"/>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="26,10" BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                    <ProgressBar Grid.Column="1" Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"
                                 Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Margin="14,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Notification}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" Margin="12,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding AuditCount, StringFormat='Audit: {0}'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
