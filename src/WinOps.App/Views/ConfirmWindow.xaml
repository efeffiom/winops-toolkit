<Window x:Class="WinOps.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm action" Width="560" SizeToContent="Height"
        MinHeight="340" ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Background="{DynamicResource ErrorBrush}" CornerRadius="8" Padding="10,5">
                <TextBlock x:Name="RiskLabel" Text="RISK" Foreground="White" FontWeight="Bold" FontSize="11"/>
            </Border>
            <TextBlock Text="WinOps Toolkit safety confirmation" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="TitleText" FontSize="21" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="2" x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="14" MinHeight="80">
            <StackPanel>
                <TextBlock Text="Execution details" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="RequirementsText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock x:Name="DetailsText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Width="110"/>
            <Button Content="I understand, proceed" IsDefault="True" Click="Confirm_Click" Style="{StaticResource DangerButton}" Width="180" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
