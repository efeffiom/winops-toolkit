<Page x:Class="WinOps.App.Views.MaintenanceView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackground}">
    <Grid Margin="26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Scan for updates" Command="{Binding ScanCommand}" Style="{StaticResource BaseButton}"/>
            <Button Content="Install updates" Command="{Binding InstallUpdatesCommand}" Style="{StaticResource DangerButton}"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <TabControl>
                <TabItem Header="Pending updates">
                    <DataGrid ItemsSource="{Binding Pending}" Height="430">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="520"/>
                            <DataGridTextColumn Header="Classification" Binding="{Binding Classification}" Width="170"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                            <DataGridTextColumn Header="Update ID" Binding="{Binding UpdateId}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Update history">
                    <DataGrid ItemsSource="{Binding History}" Height="430">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Installed" Binding="{Binding Date}" Width="170"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="560"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Repair operations">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Run selected repair" Command="{Binding RunRepairCommand}" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Repairs}" SelectedItem="{Binding SelectedRepair}" Height="390">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Operation" Binding="{Binding Title}" Width="220"/>
                                <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="420"/>
                                <DataGridTextColumn Header="Risk" Binding="{Binding RiskLevel}" Width="130"/>
                                <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="420"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
