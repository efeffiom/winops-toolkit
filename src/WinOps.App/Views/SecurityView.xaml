<Page x:Class="WinOps.App.Views.SecurityView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackground}">
    <Grid Margin="26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Refresh profiles" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Width="230"/>
            <Button Content="Assess" Command="{Binding AssessCommand}" Style="{StaticResource BaseButton}"/>
            <Button Content="Preview changes" Command="{Binding PreviewCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Apply selected profile" Command="{Binding ApplyProfileCommand}" Style="{StaticResource DangerButton}"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding Assessment.ProfileName, StringFormat='Profile: {0}  '}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Assessment.Passed, StringFormat='Passed: {0}  '}" Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="{Binding Assessment.Warnings, StringFormat='Warnings: {0}  '}" Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="{Binding Assessment.Failures, StringFormat='Failures: {0}  '}" Foreground="{DynamicResource ErrorBrush}"/>
                </WrapPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Checks}" Height="420">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/>
                        <DataGridTextColumn Header="Check" Binding="{Binding Title}" Width="250"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100"/>
                        <DataGridTextColumn Header="Current" Binding="{Binding CurrentValue}" Width="190"/>
                        <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedValue}" Width="190"/>
                        <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="420"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
