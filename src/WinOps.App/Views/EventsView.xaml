<Page x:Class="WinOps.App.Views.EventsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackground}">
    <Grid Margin="26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Load logs" Command="{Binding RefreshLogsCommand}" Style="{StaticResource SecondaryButton}"/>
                <ComboBox ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}" Width="150"/>
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" Width="130"/>
                <TextBox Text="{Binding EventId}" Width="90"/>
                <TextBox Text="{Binding Provider}" Width="170"/>
                <TextBox Text="{Binding Keyword}" Width="170"/>
                <TextBox Text="{Binding HoursBack}" Width="65" ToolTip="Hours back"/>
                <TextBox Text="{Binding MaxEvents}" Width="75" ToolTip="Maximum events"/>
                <Button Content="Query" Command="{Binding QueryCommand}" Style="{StaticResource BaseButton}"/>
                <Button Content="Export CSV" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>
                <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" Margin="0,0,10,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated}" Width="170"/>
                        <DataGridTextColumn Header="ID" Binding="{Binding EventId}" Width="80"/>
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="100"/>
                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="180"/>
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="620"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Event detail" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding SelectedEntry.TimeCreated, StringFormat='Created: {0:g}'}"/>
                    <TextBlock Text="{Binding SelectedEntry.EventId, StringFormat='Event ID: {0}'}"/>
                    <TextBlock Text="{Binding SelectedEntry.Provider, StringFormat='Provider: {0}'}"/>
                    <TextBlock Text="Message" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedEntry.Message, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True" Height="240" IsReadOnly="True"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
